cff-version: 1.2.0
type: software

message: >-
  Please cite the accompanying manuscript as under review at IEEE Access
  and identify the CometTrace version used in your analysis.

title: "CometTrace"

version: "0.38.6"

repository-code: "https://github.com/KyonghoGong/CometTrace"

license: "Apache-2.0"

authors:
  - family-names: "Gong"
    given-names: "Kyongho"

  - family-names: "Joun"
    given-names: "Jihun"

abstract: >-
  CometTrace is an open-source forensic reconstruction tool for recovering
  per-thread behavioral timelines from Perplexity Comet IndexedDB LevelDB
  artifacts. It supports reconstruction of thread and prompt context,
  plan and workflow structures, tool-event traces, provider-labeled action
  rationales where present, final responses, and persistence-state
  information.

keywords:
  - "digital forensics"
  - "browser forensics"
  - "agentic AI"
  - "behavior reconstruction"
  - "IndexedDB"
  - "LevelDB"
  - "Perplexity Comet"

preferred-citation:
  type: unpublished
  status: submitted

  title: >-
    Reconstructing Agentic AI Behavior from Browser Artifacts:
    A Forensic Case Study of Perplexity Comet

  authors:
    - family-names: "Gong"
      given-names: "Kyongho"

    - family-names: "Joun"
      given-names: "Jihun"
