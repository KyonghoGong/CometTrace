{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Verify engine integrity",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace.provenance",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": []
    },
    {
      "name": "Show CLI help",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--help"
      ]
    },
    {
      "name": "Run unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "discover",
        "-s",
        "tests",
        "-v"
      ]
    },
    {
      "name": "Reconstruct an acquisition",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--input",
        "${input:acquisition}",
        "--output",
        "${input:outputBase}.json",
        "--html-output",
        "${input:outputBase}.html"
      ]
    },
    {
      "name": "Reconstruct one stage",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--input",
        "${input:acquisition}",
        "--stage",
        "${input:stage}",
        "--output",
        "${input:outputBase}.json",
        "--html-output",
        "${input:outputBase}.html"
      ]
    },
    {
      "name": "Compare two snapshots",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--before",
        "${input:before}",
        "--after",
        "${input:after}",
        "--output",
        "${input:outputBase}.json",
        "--html-output",
        "${input:outputBase}.html"
      ]
    },
    {
      "name": "Compare two stages",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--before",
        "${input:acquisition}",
        "--after",
        "${input:acquisition}",
        "--before-stage",
        "${input:beforeStage}",
        "--after-stage",
        "${input:afterStage}",
        "--output",
        "${input:outputBase}.json",
        "--html-output",
        "${input:outputBase}.html"
      ]
    },
    {
      "name": "Run frozen v0.37",
      "type": "debugpy",
      "request": "launch",
      "module": "comettrace",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1"
      },
      "args": [
        "--engine",
        "v037",
        "--database",
        "keyval-store",
        "--input",
        "${input:acquisition}",
        "--output",
        "${input:outputBase}.json",
        "--html-output",
        "${input:outputBase}.html"
      ]
    }
  ],
  "inputs": [
    {
      "id": "acquisition",
      "type": "promptString",
      "description": "Path to your copied acquisition ZIP or directory"
    },
    {
      "id": "stage",
      "type": "promptString",
      "description": "Stage ID to reconstruct"
    },
    {
      "id": "before",
      "type": "promptString",
      "description": "Before acquisition path"
    },
    {
      "id": "after",
      "type": "promptString",
      "description": "After acquisition path"
    },
    {
      "id": "beforeStage",
      "type": "promptString",
      "description": "Before stage ID"
    },
    {
      "id": "afterStage",
      "type": "promptString",
      "description": "After stage ID"
    },
    {
      "id": "outputBase",
      "type": "promptString",
      "description": "Output path and basename without an extension",
      "default": "output/reconstruction"
    }
  ]
}
